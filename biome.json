{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!.worktrees",
      "!.claude",
      "!pnpm-lock.yaml",
      "!contracts/previous/pnpm-lock.yaml",
      "!config/wirecat",
      "!contracts/wirecat.json",
      "!**/spec"
    ]
  },
  "extends": ["./config/wirecat/biome.base.json"],
  "plugins": [
    {
      "path": "./node_modules/@wirecat/cli-base/config/lint/no-own-settings.grit",
      "includes": ["src/**", "!**/*.test.ts", "!src/testing/**"]
    }
  ],
  "overrides": [
    {
      "includes": ["src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "cli-core's appMcpCommand serves MCP; commands and services do not know the protocol"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/commands/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@modelcontextprotocol/**"],
                    "message": "cli-core's appMcpCommand serves MCP; commands and services do not know the protocol"
                  },
                  {
                    "group": ["**/yandex/transport.js", "**/yandex/transport"],
                    "message": "commands speak to the Disk through src/yandex/source.ts and writes.ts; only src/yandex/ and context.ts build requests (WC-ARCH-1, WC-ARCH-3)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
