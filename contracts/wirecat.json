{
  "wcat_manifest": 2,
  "name": "ydisk",
  "description": "a new WireCat CLI, started from cli-template",
  "docs_url": "https://github.com/WireCatLabs/ydisk#readme",
  "package": "@wirecat/yandex-disk-cli",
  "bin": "wcat-ydisk",
  "commands": [
    {
      "path": [
        "commands"
      ],
      "summary": "every command by section; --json prints its contract, one path per call",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "commands",
        "info"
      ],
      "summary": "one command contract, or all schemas, error reasons and explicit overrides",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "session",
        "start"
      ],
      "summary": "sign in to Example Comments with an API token",
      "effects": {
        "remote": "read",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "status"
      ],
      "summary": "show where this profile's token comes from; never the token",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "session",
        "end"
      ],
      "summary": "forget this profile's token on this computer",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "session",
        "list"
      ],
      "summary": "list the profiles here and whether each is signed in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "api",
        "list"
      ],
      "summary": "list every Yandex Disk API operation this CLI offers, without calling Yandex…",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "permission": "api.list",
      "entity": "api_operation"
    },
    {
      "path": [
        "api",
        "show"
      ],
      "summary": "show one operation's parameters and request schema, without calling Yandex Disk",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "permission": "api.show"
    },
    {
      "path": [
        "api",
        "disk-get"
      ],
      "summary": "Получить метаинформацию о диске пользователя — read (GET /v1/disk)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.disk-get"
    },
    {
      "path": [
        "api",
        "resources-list"
      ],
      "summary": "Получить метаинформацию о файле или каталоге — read (GET /v1/disk/resources)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.resources-list"
    },
    {
      "path": [
        "api",
        "resources-create"
      ],
      "summary": "Создать каталог — write (PUT /v1/disk/resources)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.resources-create"
    },
    {
      "path": [
        "api",
        "resources-update"
      ],
      "summary": "Обновить пользовательские данные ресурса — write (PATCH /v1/disk/resources)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.resources-update"
    },
    {
      "path": [
        "api",
        "resources-delete"
      ],
      "summary": "Удалить файл или папку — destructive (DELETE /v1/disk/resources)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.resources-delete"
    },
    {
      "path": [
        "api",
        "resources-copy"
      ],
      "summary": "Создать копию файла или папки — write (POST /v1/disk/resources/copy)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.resources-copy"
    },
    {
      "path": [
        "api",
        "resources-download-link"
      ],
      "summary": "Получить ссылку на скачивание файла — read (GET /v1/disk/resources/download)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.resources-download-link"
    },
    {
      "path": [
        "api",
        "resources-files-list"
      ],
      "summary": "Получить список файлов упорядоченный по имени — read (GET…",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.resources-files-list"
    },
    {
      "path": [
        "api",
        "resources-last-uploaded-list"
      ],
      "summary": "Получить список файлов упорядоченный по дате загрузки — read (GET…",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.resources-last-uploaded-list"
    },
    {
      "path": [
        "api",
        "resources-move"
      ],
      "summary": "Переместить файл или папку — write (POST /v1/disk/resources/move)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.resources-move"
    },
    {
      "path": [
        "api",
        "resources-public-list"
      ],
      "summary": "Получить список опубликованных ресурсов — read (GET /v1/disk/resources/public)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.resources-public-list"
    },
    {
      "path": [
        "api",
        "resources-publish"
      ],
      "summary": "Опубликовать ресурс — write (PUT /v1/disk/resources/publish)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.resources-publish"
    },
    {
      "path": [
        "api",
        "resources-unpublish"
      ],
      "summary": "Отменить публикацию ресурса — write (PUT /v1/disk/resources/unpublish)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.resources-unpublish"
    },
    {
      "path": [
        "api",
        "resources-upload-link"
      ],
      "summary": "Получить ссылку для загрузки файла — read (GET /v1/disk/resources/upload)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.resources-upload-link"
    },
    {
      "path": [
        "api",
        "resources-upload-url"
      ],
      "summary": "Загрузить файл в Диск по URL — write (POST /v1/disk/resources/upload)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.resources-upload-url"
    },
    {
      "path": [
        "api",
        "public-resources-get"
      ],
      "summary": "Получить метаинформацию о публичном файле или каталоге — read (GET…",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.public-resources-get"
    },
    {
      "path": [
        "api",
        "public-resources-download-link"
      ],
      "summary": "Получить ссылку на скачивание публичного ресурса — read (GET…",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.public-resources-download-link"
    },
    {
      "path": [
        "api",
        "public-settings-update"
      ],
      "summary": "Обновить настройки публичных ссылок — write (PATCH…",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.public-settings-update"
    },
    {
      "path": [
        "api",
        "public-resources-save-to-disk"
      ],
      "summary": "Сохранить публичный ресурс в папку Загрузки — write (POST…",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.public-resources-save-to-disk"
    },
    {
      "path": [
        "api",
        "trash-resources-list"
      ],
      "summary": "Получить содержимое Корзины — read (GET /v1/disk/trash/resources)",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.trash-resources-list"
    },
    {
      "path": [
        "api",
        "trash-resources-delete"
      ],
      "summary": "Очистить Корзину — destructive (DELETE /v1/disk/trash/resources)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.trash-resources-delete"
    },
    {
      "path": [
        "api",
        "trash-resources-restore"
      ],
      "summary": "Восстановить ресурс из Корзины — write (PUT /v1/disk/trash/resources/restore)",
      "effects": {
        "remote": "write",
        "local": "none"
      },
      "permission": "api.trash-resources-restore"
    },
    {
      "path": [
        "api",
        "operations-get"
      ],
      "summary": "Получить статус асинхронной операции — read (GET…",
      "effects": {
        "remote": "read",
        "local": "none"
      },
      "permission": "api.operations-get"
    },
    {
      "path": [
        "comments",
        "list"
      ],
      "summary": "list the comments in Example Comments, newest first",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "comments.list",
      "entity": "comment"
    },
    {
      "path": [
        "comments",
        "show"
      ],
      "summary": "show one comment in Example Comments",
      "effects": {
        "remote": "read",
        "local": "read"
      },
      "permission": "comments.show",
      "entity": "comment"
    },
    {
      "path": [
        "comments",
        "create"
      ],
      "summary": "post a comment in Example Comments",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "comments.create"
    },
    {
      "path": [
        "comments",
        "update"
      ],
      "summary": "change the text of your comment in Example Comments",
      "effects": {
        "remote": "write",
        "local": "write"
      },
      "permission": "comments.update"
    },
    {
      "path": [
        "doctor"
      ],
      "summary": "the state this installation is in, without connecting unless --online",
      "effects": {
        "remote": "read",
        "local": "read"
      }
    },
    {
      "path": [
        "doctor",
        "reports",
        "show"
      ],
      "summary": "what a report holds and never holds, and where to send it; writes nothing",
      "effects": {
        "remote": "none",
        "local": "none"
      }
    },
    {
      "path": [
        "doctor",
        "reports",
        "create"
      ],
      "summary": "the report file written: its path, the run it is about, and where to send it",
      "effects": {
        "remote": "none",
        "local": "write"
      },
      "permission": "doctor.reports.create"
    },
    {
      "path": [
        "skill",
        "show"
      ],
      "summary": "print the tool's instructions for AI agents",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "skill",
        "install"
      ],
      "summary": "install the tool's instructions for AI agents",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "skill",
        "status"
      ],
      "summary": "whether the installed instructions for AI agents match this version",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "serve"
      ],
      "summary": "serve this profile's commands to an AI agent",
      "effects": {
        "remote": "write",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "revoke"
      ],
      "summary": "forget every login given to a browser app",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "start"
      ],
      "summary": "start the HTTP MCP server in the background",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "stop"
      ],
      "summary": "stop the background HTTP MCP server",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "server",
        "status"
      ],
      "summary": "whether the HTTP MCP server runs, its login code and the apps logged in",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "config"
      ],
      "summary": "print the local MCP configuration of this profile, or of those --profiles names",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "mcp",
        "add"
      ],
      "summary": "add this profile's local MCP server to Codex or Claude Code",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "mcp",
        "check"
      ],
      "summary": "check this profile's local MCP handshake and tool list",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "upgrade"
      ],
      "summary": "upgrade ydisk with the package manager that installed it; --check only looks",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "show"
      ],
      "summary": "the profile, the profiles that exist, and each setting with where it came from",
      "effects": {
        "remote": "none",
        "local": "read"
      }
    },
    {
      "path": [
        "config",
        "set"
      ],
      "summary": "save a setting to the configuration file",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "unset"
      ],
      "summary": "remove a setting from the configuration file",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "migrate"
      ],
      "summary": "write each setting the file lacks at its default, keeping yours",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "config",
        "repair"
      ],
      "summary": "fix the settings file's JSON syntax, keeping every value",
      "effects": {
        "remote": "none",
        "local": "write"
      }
    },
    {
      "path": [
        "runs",
        "list"
      ],
      "summary": "recorded runs, newest first",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "entity": "run"
    },
    {
      "path": [
        "runs",
        "show"
      ],
      "summary": "one run: what it was, how it ended, and every event it logged",
      "effects": {
        "remote": "none",
        "local": "read"
      },
      "entity": "run"
    },
    {
      "path": [
        "runs",
        "path"
      ],
      "summary": "the directory holding one run",
      "effects": {
        "remote": "none",
        "local": "none"
      },
      "entity": "run_location"
    }
  ],
  "entities": {
    "api_operation": {
      "fields": [
        "effect",
        "tag"
      ]
    },
    "comment": {
      "fields": [
        "author"
      ]
    },
    "run": {
      "fields": [
        "run_id",
        "command",
        "profile",
        "started_at",
        "completed_at",
        "status",
        "requests",
        "duration_ms",
        "cli_version",
        "runtime",
        "platform",
        "arch",
        "error_code",
        "provider_error",
        "kept_because_failed",
        "operations",
        "codes",
        "trace_id",
        "cli_command",
        "argv",
        "unknown_command",
        "via",
        "events_dropped",
        "directory",
        "event_count",
        "events_truncated"
      ]
    }
  },
  "network": {
    "hosts": [
      "cloud-api.yandex.net",
      "downloader.disk.yandex.ru",
      "*.disk.yandex.net",
      "comments.example.invalid",
      "registry.npmjs.org",
      "huggingface.co",
      "*.huggingface.co",
      "*.hf.co",
      "github.com",
      "*.githubusercontent.com"
    ]
  },
  "desktop": {
    "tagline": "A new WireCat CLI, started from cli-template",
    "profiles": {
      "args": [
        "session",
        "list",
        "--no-record",
        "--json"
      ],
      "shape": "items"
    },
    "doctor": [
      "{profile}",
      "doctor",
      "--record",
      "--json"
    ],
    "runs": {
      "list": [
        "runs",
        "list",
        "{query}",
        "--limit",
        "{limit}",
        "--page",
        "{page}",
        "--no-record",
        "--json"
      ],
      "show": [
        "runs",
        "show",
        "{run}",
        "--no-record",
        "--json"
      ]
    },
    "search": null,
    "setup": [
      "{profile}",
      "session",
      "start"
    ],
    "signIn": {
      "gives": "Lets your agent read and change your account through ydisk.",
      "asks": "An API token or key from the service."
    },
    "skill": {
      "status": [
        "skill",
        "status",
        "--no-record",
        "--json"
      ],
      "install": [
        "skill",
        "install",
        "--for",
        "{target}",
        "--json"
      ],
      "show": [
        "skill",
        "show",
        "--no-record",
        "--json"
      ]
    },
    "mcpServer": {
      "start": [
        "mcp",
        "server",
        "start",
        "--port",
        "{port}",
        "--public-url",
        "{url}",
        "--profiles",
        "all",
        "--json"
      ],
      "stop": [
        "mcp",
        "server",
        "stop",
        "--profiles",
        "all",
        "--json"
      ],
      "status": [
        "mcp",
        "server",
        "status",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ],
      "revoke": [
        "mcp",
        "revoke",
        "--profiles",
        "all",
        "--json"
      ],
      "config": [
        "mcp",
        "config",
        "--profiles",
        "all",
        "--no-record",
        "--json"
      ]
    },
    "tasks": null,
    "sync": null,
    "storeInfo": null,
    "storeTables": null,
    "storeTableSizes": null,
    "storeCheck": null,
    "storeBackup": null,
    "storeBackupEncrypted": null,
    "storeResetPreview": null,
    "storeReset": null,
    "storage": {
      "app": "yandex-disk-cli",
      "env": "YDISK"
    },
    "settings": null
  }
}
